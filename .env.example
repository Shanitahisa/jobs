# Copy to .env. Environment variables override this file.
DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-local-value
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://127.0.0.1:5174
DEMO_PAYMENTS=1
# Use only a Flutterwave v3 TEST secret key. Never use a live key here.
FLUTTERWAVE_SECRET_KEY=
# Gmail SMTP. Use a Google App Password, not your normal account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_SENDER_NAME=Gig House
EMAIL_REPLY_TO=
EMAIL_ENABLED=1
# Optional PostgreSQL. Leave POSTGRES_DB empty to use SQLite.
POSTGRES_DB=flip
POSTGRES_USER=flip
POSTGRES_PASSWORD=replace-with-your-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
